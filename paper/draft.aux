\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Synchrony at word onset. (A) Change in alpha ciPLV (top) and high-gamma AEC-c (bottom) per region, word on vs.\ off: each electrode's mean change over all partners, averaged per subject; mean $\pm $ SEM across subjects; stars: BH-FDR. (B) Time-resolved alpha ciPLV network in 200 ms windows. Red nodes: hubs, regions whose mean change over their connections differs from zero (two-stage FDR over regions $\times $ windows); lines: each hub's five strongest connections (red: synchronized, blue: desynchronized; width $\propto |t|$).\relax }}{8}{figure.caption.4}\protected@file@percent }
\newlabel{fig:synchrony}{{4}{8}{Synchrony at word onset. (A) Change in alpha ciPLV (top) and high-gamma AEC-c (bottom) per region, word on vs.\ off: each electrode's mean change over all partners, averaged per subject; mean $\pm $ SEM across subjects; stars: BH-FDR. (B) Time-resolved alpha ciPLV network in 200 ms windows. Red nodes: hubs, regions whose mean change over their connections differs from zero (two-stage FDR over regions $\times $ windows); lines: each hub's five strongest connections (red: synchronized, blue: desynchronized; width $\propto |t|$).\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces High-gamma response peak after long minus short waits (median split of the blank before each word), responsive electrodes only; mean $\pm $ SEM across subjects; stars: BH-FDR.\relax }}{9}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Recall prediction from the high-gamma response (encoding contrast: recalled vs.\ not recalled). AUC per lobe and 100 ms window, mean $\pm $ SEM across subjects; dashed line: 0.5; stars: AUC $>0.5$, BH-FDR over lobe $\times $ window.\relax }}{9}{figure.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Session-to-session reliability: per subject, Pearson r across regions between two random halves of the subject's sessions, for power (left) and synchrony node strength (right); dashed lines: medians.\relax }}{10}{figure.caption.7}\protected@file@percent }
