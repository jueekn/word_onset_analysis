\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Power changes at word onset (word on vs.\ word off). (A) Cohen's d of alpha (8--13 Hz, top) and high-gamma (70--150 Hz, bottom) power per region; mean $\pm $ SEM across subjects; numbers: subjects; stars: BH-FDR. (B) The strongest region, occipital cortex, by subregion: t across subjects per frequency for the four occipital subregions with the most subjects (hemispheres pooled); stars: significant (TFCE, family-wise $p<.05$).\relax }}{5}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:power}{{1}{5}{Power changes at word onset (word on vs.\ word off). (A) Cohen's d of alpha (8--13 Hz, top) and high-gamma (70--150 Hz, bottom) power per region; mean $\pm $ SEM across subjects; numbers: subjects; stars: BH-FDR. (B) The strongest region, occipital cortex, by subregion: t across subjects per frequency for the four occipital subregions with the most subjects (hemispheres pooled); stars: significant (TFCE, family-wise $p<.05$).\relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spectral profile of the word-onset response. (A) t across subjects per region and frequency (5--150 Hz, log-spaced bins; 50, 60, 100, 120 Hz excluded); outlines: significant runs (TFCE, family-wise $p<.05$). (B) Mixed-effects lobe $\times $ band interaction: how much the alpha-vs-high-gamma pattern differs between each pair of lobes ($|d|$); stars: Holm-corrected $p$.\relax }}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:spectrum}{{2}{6}{Spectral profile of the word-onset response. (A) t across subjects per region and frequency (5--150 Hz, log-spaced bins; 50, 60, 100, 120 Hz excluded); outlines: significant runs (TFCE, family-wise $p<.05$). (B) Mixed-effects lobe $\times $ band interaction: how much the alpha-vs-high-gamma pattern differs between each pair of lobes ($|d|$); stars: Holm-corrected $p$.\relax }{figure.caption.2}{}}
