\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Order of high-gamma responses after word onset. (A) Half-max latency per anatomical subregion (left; mean $\pm $ SEM across subjects; n: subjects) and the average high-gamma response over time, as a fraction of its peak (right). (B) Estimated latency per lobe from a mixed-effects model (mean $\pm $ SE); brackets: neighbouring lobes in the latency order (Holm over all 15 pairs).\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:latency}{{3}{7}{Order of high-gamma responses after word onset. (A) Half-max latency per anatomical subregion (left; mean $\pm $ SEM across subjects; n: subjects) and the average high-gamma response over time, as a fraction of its peak (right). (B) Estimated latency per lobe from a mixed-effects model (mean $\pm $ SE); brackets: neighbouring lobes in the latency order (Holm over all 15 pairs).\relax }{figure.caption.3}{}}
