# ---------------------------------------------------------------------------
# Generated output. All of it is reproducible by rerunning the pipeline, and
# figures/ alone is ~76 MB -- committing it would dwarf the code and make every
# replot a diff.
# ---------------------------------------------------------------------------
figures/
results/
processed_results/

# OpenNeuro download cache (cml_data; override with CML_BIDS_CACHE) and the
# per-session artifact tree (config.yaml paths.scratch_dir).
bids_data/
scratch/
scratch.smokescreen/
figures.smokescreen/
.snakemake/
test_root/
logs/

# Computed data. Session pickles live on scratch, but guard against a stray
# write into the repo -- these are large and always regenerable.
*.pkl
*.npy
*.h5

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environments
.pixi/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
*.bak
*~
*.tmp
